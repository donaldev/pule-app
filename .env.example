# Local Supabase only. Copy to .env.local after `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Replace with LOCAL publishable key (or local legacy anon key) from `supabase status`.
# Never use a secret or service-role key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_LOCAL_KEY

# Enable only after the audited atomic 202611100002/0003/0004 release and both workers are ready.
VITE_FRAME_RECORDING_UPLOADS=false

# Optional R2 source upload broker on the existing Pages app. Leave unset until reviewed rollout.
# This is a public endpoint URL, never an R2 or Supabase server credential.
# VITE_RECORDING_UPLOAD_API_URL=https://pule-app.pages.dev/api/recordings
